# ─────────────────────────────────────────────
# 자격증명 — 절대 커밋 금지. 공개 레포다.
# 한 번 커밋되면 이력에 영구히 남아, 지워도 유출로 봐야 한다.
# ─────────────────────────────────────────────
.env
.env.*
*.env
secrets.*
config.local.*

# 네이버
*naver_state.json
data/.auth/

# 구글 / 유튜브 OAuth
client_secret*.json
credentials*.json
token.json
token.pickle
*.pickle

# 일반 토큰·키
*api_key*
*apikey*
*.pem
*.key

# ─────────────────────────────────────────────
# 수집 데이터·산출물 — 용량이 크고 타인이 쓴 글이다. 로컬에만 둔다.
# ─────────────────────────────────────────────
data/
output/
*.jsonl
*.csv
*.tsv
*.xlsx
*.db
*.sqlite3

# 미디어 (유튜브 다운로드·자막)
*.mp4
*.webm
*.m4a
*.srt
*.vtt

# ─────────────────────────────────────────────
# 파이썬
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

